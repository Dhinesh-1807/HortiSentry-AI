# HortiSentry Environment Configuration Example

APP_ENV=development
SECRET_KEY=development-secret-key-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///./hortisentry.db

# ML Service Configuration
ML_MODE=REAL
CONFIDENCE_THRESHOLD=0.70
MODEL_PATH=ml/artifacts/tomato_v1.pt

# AI Evidence Engine & Provider Configuration
SEARCH_PROVIDER=local
SEARCH_API_KEY=
LLM_PROVIDER=local
LLM_API_KEY=
VISION_PROVIDER=pytorch
VISION_API_KEY=

# Application Settings
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
CROP_CONFIG_PATH=config/crops.yaml

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

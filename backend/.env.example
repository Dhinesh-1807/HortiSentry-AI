# HortiSentry Environment Configuration

# APP Settings
APP_NAME=HortiSentry — AI-Powered Horticultural Disease Observation and Expert Escalation System
APP_ENV=development
DEBUG=True

# --- DATABASE CONFIGURATION ---
# 1. Local SQLite (Default):
# DATABASE_URL=sqlite:///./hortisentry.db

# 2. Supabase PostgreSQL (Replace with your actual Supabase credentials):
# Format: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler: postgresql+psycopg2://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
